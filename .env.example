# Copy to .env for local runs. Never commit .env.
ANTHROPIC_API_KEY=
# Shared code applicants type to get in (leave empty to disable the gate locally)
ACCESS_CODE=change-me
# Model and cost controls
MODEL=claude-opus-5-5
EFFORT=low
# Server-side refusal fallback ("default" or "off"); only used on models that support it
FALLBACKS=default
# Max tokens (input+output) a single practice session may spend
SESSION_TOKEN_BUDGET=400000
# "anthropic" for real calls, "fake" for an offline demo/tests without a key
LLM_PROVIDER=anthropic
DB_PATH=./podsim.db
